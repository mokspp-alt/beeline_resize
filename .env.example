# Бэкенд beeline_resize
PORT=8787
# Командный токен для плагина (Authorization: Bearer ...). Обязателен.
PLUGIN_TOKEN=change-me
# Figma personal access token для скана библиотек Carnica (file_content:read, library_content:read)
FIGMA_TOKEN=

# LLM-провайдер: anthropic | openai-compatible | gigachat | yandexgpt | none (без AI)
LLM_PROVIDER=anthropic
# Пусто — модель провайдера по умолчанию (anthropic: claude-opus-5-5, gigachat: GigaChat-2-Max, yandexgpt: yandexgpt/latest)
LLM_MODEL=
# Только anthropic: low | medium | high | xhigh | max
LLM_EFFORT=medium
LLM_TIMEOUT_MS=30000
LLM_MAX_CONCURRENT_PER_USER=4

ANTHROPIC_API_KEY=

OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
# json_schema | json_object | none
OPENAI_COMPATIBLE_JSON_MODE=json_schema
OPENAI_COMPATIBLE_VISION=false

# Ключ авторизации GigaChat (base64 client_id:client_secret). Нужны сертификаты НУЦ Минцифры:
# NODE_EXTRA_CA_CERTS=/path/to/russian_trusted_root_ca.pem
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS

YANDEXGPT_API_KEY=
YANDEXGPT_FOLDER_ID=

# Политика данных
DATA_ALLOW_PREVIEW=true
DATA_MASK_TEXTS=false
# Провайдеры, допустимые для конфиденциальных файлов
CONFIDENTIAL_PROVIDERS=openai-compatible,gigachat,yandexgpt
